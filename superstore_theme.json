{
  "name": "Superstore Clean",
  "dataColors": [
    "#2563EB",
    "#F59E0B",
    "#10B981",
    "#8B5CF6",
    "#EF4444",
    "#64748B"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F3F4F6" } },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "bold": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E7EB" } },
            "radius": 6
          }
        ]
      }
    }
  }
}
